"""Template for NASA Earthdata credentials (local GPM IMERG download).

Copy this file to ``data/earthdata_credentials.py`` (gitignored) and fill in
your Earthdata Login. NEVER commit the real file — it stays local. For CI,
use the EARTHDATA_USER / EARTHDATA_PASSWORD repository secrets instead
(see .github/workflows/build-thresholds.yaml).

  cp earthdata_credentials.py.example data/earthdata_credentials.py
  # then edit the two values below

Register free at https://urs.earthdata.nasa.gov/home and authorise the
"NASA GESDISC DATA ARCHIVE" application (Profile -> Applications).
"""

EARTHDATA_USER = "YOUR_EARTHDATA_USERNAME"
EARTHDATA_PASSWORD = "YOUR_EARTHDATA_PASSWORD"
