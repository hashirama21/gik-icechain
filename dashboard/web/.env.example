# Copy to .env.local and adjust. All are build-time (NEXT_PUBLIC_*) for static export.

# Base path when served under a subpath (GitHub Pages project site).
NEXT_PUBLIC_BASE_PATH=/gik-icechain

# TiTiler endpoint serving the COGs (local Docker by default).
NEXT_PUBLIC_TITILER_BASE=http://localhost:8000

# Public bucket / URL prefix holding the COGs TiTiler reads.
NEXT_PUBLIC_COG_BASE=https://gik-icechain-cogs.s3.eu-west-1.amazonaws.com/cogs
